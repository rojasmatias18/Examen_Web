generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int       @id @default(autoincrement())
  name     String
  email    String    @unique
  password String
  role     Role
  bookings Booking[]
}

model Schedule {
  id        Int       @id @default(autoincrement())
  court     String
  startTime DateTime
  endTime   DateTime
  bookings  Booking[]
}

model Booking {
  id         Int      @id @default(autoincrement())
  date       DateTime
  userId     Int
  scheduleId Int
  user       User     @relation(fields: [userId], references: [id])
  schedule   Schedule @relation(fields: [scheduleId], references: [id])
}

enum Role {
  ADMIN
  USER
}
