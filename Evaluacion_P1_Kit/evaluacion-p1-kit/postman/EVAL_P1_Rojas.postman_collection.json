    {
      "name": "Login ADMIN",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"paulo.galarza@example.com\", \"password\": \"admin123\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if(pm.response.code===200)pm.environment.set(\"adminToken\",pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Login USER (completar email y clave)",
