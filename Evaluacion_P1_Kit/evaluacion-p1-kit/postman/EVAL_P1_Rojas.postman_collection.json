          "raw": "{\"email\": \"CAMBIAR_EMAIL_INSTITUCIONAL\", \"password\": \"CAMBIAR_PASSWORD\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if(pm.response.code===200){pm.environment.set(\"userToken\",pm.response.json().token);pm.environment.set(\"token\",pm.response.json().token);}"
            ]
          }
        }
      ]
